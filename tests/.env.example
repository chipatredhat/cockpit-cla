# Copy to tests/.env (gitignored) and fill in. Never commit real credentials.
# See TESTING.md for what each host and account needs.

# Cockpit URL of the test host (RHEL 9 or 10 with command-line-assistant).
COCKPIT_URL=https://rhel10-test.example.com:9090
# A normal account on that host that can use the assistant and has sudo
# (the suite turns on administrative access).
COCKPIT_USER=testuser
# That account's password.
COCKPIT_PASS=

# Optional: an account the assistant is disabled for by a D-Bus deny policy
# (TESTING.md "The disabled-user fixture"). Leave empty to skip those specs.
COCKPIT_DENIED_USER=denieduser
# That account's password. Empty skips the disabled-user specs.
COCKPIT_DENIED_PASS=

# Optional: ssh target (user@host) for the same host as COCKPIT_USER, used to
# confirm results with the `c` command and rpm (key-based login; BatchMode).
# Empty skips those checks. Example: testuser@rhel10-test.example.com
COCKPIT_SSH=
# Optional: an ssh_config file (ssh -F) for COCKPIT_SSH.
COCKPIT_SSH_CONFIG=
